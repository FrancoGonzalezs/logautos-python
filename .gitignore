# La replica local: se regenera con scripts/importar_dump.py y pesa ~200 MB.
local.db
local.db-wal
local.db-shm
data/*.db
data/*.db-wal
data/*.db-shm

# Todo lo que la app deja en data/ es cache o trabajo local: la UF del mes se
# rehace sola desde mindicador.cl y las bases de prueba se regeneran con el
# importador. Va el comodin y no uf.json a secas, para que un archivo nuevo no
# se cuele por olvido.
data/*.json

# La clave con que se firman las cookies de sesion, generada al azar la
# primera vez que arranca sin SECRET_KEY. Publicarla equivaldria a volver a la
# clave fija que habia antes del login real.
data/.secret_key

# Las fotos que sube el check list de ingreso. Van al volumen persistente
# (DATA_DIR), nunca al repo: son fotos de unidades de clientes reales y ademas
# pesan lo que pesa una camara de telefono.
data/uploads/

# La semilla que genera scripts/semilla_volumen.py: lleva tbl_users completa,
# o sea emails, RUT, telefonos y hashes de 144 personas reales. Se genera, se
# aplica y se borra -- al repo no va nunca.
semilla*.sql.gz

# Dumps y respaldos
*.sql
*.sql.gz
*.zip

__pycache__/
*.py[cod]
.venv/
venv/
.env
